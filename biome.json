{
  "$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useImportType": "off",
        "useExportType": "off"
      }
    }
  },
  "javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } }
}
